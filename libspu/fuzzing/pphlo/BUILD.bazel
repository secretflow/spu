load("//bazel:spu.bzl", "spu_cc_binary", "spu_cc_library")

package(default_visibility = ["//visibility:public"])

spu_cc_library(
    name = "FuzzingUtils",
    hdrs = [
        "FuzzedDataProvider.h",
        "GenOps.h",
    ],
)

spu_cc_binary(
    name = "spu_vm_verifier",
    testonly = True,
    srcs = ["spu_vm_verifier.cc"],
    deps = [
        ":FuzzingUtils",
        "//libspu/compiler:compile",
        "//libspu/device:api",
        "//libspu/device:io",
        "//libspu/device:test_utils",
        "//libspu/device/pphlo:pphlo_executor",
        "//libspu/device/utils:pphlo_executor_test_runner",
    ],
)
